# Copy to ".env" (same folder as docker-compose.yml) and fill in.
# docker-compose reads .env automatically; never commit the real .env.

# Required to turn on login. Leave empty to disable auth (LAN/dev only).
MANGA_DL_PASSWORD=change-me

# Optional: also require a username. Leave empty for password-only.
MANGA_DL_USERNAME=

# Set to 1 when served over HTTPS (e.g. behind the Cloudflare proxy) so the
# session cookie gets the Secure flag. Leave empty if you also hit the app
# over plain HTTP on the LAN, or the cookie won't be stored there.
MANGA_DL_COOKIE_SECURE=1
